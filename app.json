{
  "expo": {
    "scheme": "bartenderapp",
    "name": "Mag-nificent Drinks",
    "slug": "bartender-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#0a0a0a",
      "backgroundColor": "#0a0a0a"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tillåt att bartender-app använder kameran för att fotografera drinkar.",
          "microphonePermission": false,
          "photosPermission": "Tillåt att bartender-app använder ditt bildbibliotek för drinkbilder."
        }
      ],
      "expo-font"
    ]
  }
}
